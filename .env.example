# Environment Variables
GEMINI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=odontomanager_verify

# WAHA (WhatsApp Web) - somente no servidor. Em Docker, use o nome do serviço;
# fora dele, informe a porta externa do WAHA (nunca a porta 3000 deste app).
# Configure WHATSAPP_HOOK_URL no WAHA como:
# https://SEU_DOMINIO/api/integrations/whatsapp/waha/webhook
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Clinica Experts (somente no servidor; nunca use prefixo VITE_)
CLINICA_EXPERTS_API_TOKEN=

# Segredo aleatorio usado na URL do webhook configurado no Clinica Experts
CLINICA_EXPERTS_WEBHOOK_SECRET=

# Intervalo do espelhamento automatico em servidor persistente (minimo: 1)
CLINICA_EXPERTS_SYNC_INTERVAL_MINUTES=1

# Necessarios somente para sincronizacao agendada sem usuario conectado
CLINICA_EXPERTS_OWNER_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
