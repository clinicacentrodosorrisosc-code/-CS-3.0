rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'clinica.centrodosorrisosc@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Clinic Ideas
    match /clinic_ideas/{ideaId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidId(ideaId)
        && isValidClinicIdea(incoming())
        && incoming().creator_id == request.auth.uid;
        
      allow update: if isSignedIn() 
        && isValidClinicIdea(incoming())
        && (isAdmin() || existing().creator_id == request.auth.uid)
        && incoming().creator_id == existing().creator_id
        && incoming().created_at == existing().created_at;
        
      allow delete: if isAdmin() || (isSignedIn() && existing().creator_id == request.auth.uid);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
          && isValidId(commentId)
          && isValidComment(incoming())
          && incoming().user_id == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && existing().user_id == request.auth.uid);
      }
    }

    match /chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(messageId)
        && isValidChatMessage(incoming());
      allow update, delete: if false;
    }

    function isValidClinicIdea(data) {
      return data.keys().hasAll(['title', 'status', 'priority', 'created_at', 'creator_id'])
        && data.title is string && data.title.size() <= 200
        && data.status in ['Idea', 'Planning', 'Implementing', 'Done', 'Archived']
        && data.priority in ['Low', 'Medium', 'High']
        && data.created_at is string
        && data.creator_id == request.auth.uid;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['text', 'user_id', 'created_at'])
        && data.text is string && data.text.size() <= 1000
        && data.user_id == request.auth.uid
        && data.created_at is string;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['content', 'senderId', 'senderName', 'timestamp'])
        && data.content is string && data.content.size() <= 2000
        && data.senderId is string && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() <= 100
        && data.timestamp is string;
    }
  }
}
