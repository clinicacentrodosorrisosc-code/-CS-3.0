{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/crm/middleware.ts",
    "src/crm/middleware.test.ts",
    "src/crm/lib/rate-limit.ts",
    "src/crm/lib/supabase/server.ts",
    "supabase/supabase_webhook_handler.ts",
    "supabase_webhook_handler.ts",
    "*.ts",
    "test-*.mjs",
    "check-*.mjs",
    "fix_*.mjs"
  ]
}
